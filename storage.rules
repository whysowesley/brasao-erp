rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'wesleyjunio197@gmail.com';
    }

    // Logos, comprovantes e demais arquivos internos são exclusivos do proprietário.
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
  }
}
