rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Assets institucionais e branding da Galeteria Brasão
    match /assets/branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Documentos fiscais, notas e comprovantes de pagamentos
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Padrão protegido para arquivos internos
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
