rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'wesleyjunio197@gmail.com';
    }

    // Este ERP é de uso individual: somente o proprietário acessa qualquer coleção.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
