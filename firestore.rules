rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && (
          (request.auth.token.email != null && request.auth.token.email.lower() == 'wesleyjunio197@gmail.com')
          || (request.auth.token.email != null && request.auth.token.email.lower().matches('.*wesley.*'))
          || (request.auth.token.email != null && request.auth.token.email.lower().matches('.*brasao.*'))
        );
    }

    function isApprovedUser() {
      return request.auth != null && (
        isOwner() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master'
          )
        )
      );
    }

    // Permite que usuários autenticados leiam e criem seu próprio perfil de usuário.
    // Atualização de aprovação ou alteração de papéis é permitida para administradores aprovados ou proprietário.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if isApprovedUser() || isOwner();
    }

    // Todas as outras coleções do ERP (produtos, contagens, pedidos, fornecedores, lançamentos financeiros, etc.)
    // exigem estritamente que o usuário esteja autenticado E aprovado.
    match /{document=**} {
      allow read, write: if isApprovedUser();
    }
  }
}

